---
import Base from '../layouts/Base.astro';
import Leaf from '../components/Leaf.astro';
import PostRow from '../components/PostRow.astro';
import { getPosts, SITE } from '../site';
const posts = await getPosts();
---
<Base current="posts">
  <section id="about" lang="en" class="hero">
    <svg class="leaf-sway hero-leaf" width="360" height="360" viewBox="0 0 200 200" fill="none" style="stroke:var(--green-mid)" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
      <path d="M30 180C30 90 90 30 180 30C180 120 120 180 30 180Z"></path>
      <path d="M30 180L140 70"></path>
      <path d="M70 140L70 100"></path><path d="M70 140L110 140"></path>
      <path d="M100 110L100 72"></path><path d="M100 110L138 110"></path>
    </svg>
    <div class="wrap hero-inner">
      <p class="pill"><span aria-hidden="true"></span>{SITE.slogan}</p>
      <h1>Hi, I'm SilkSong.<br />A programmer who thinks, <em>writes</em> &amp; shares.</h1>
      <p class="bio">This blog is my space to think out loud, keep notes, and share what I learn along the way. I love open source and AI, and right now I'm digging deep into how to build AI agents.</p>
      <div class="cta">
        <a class="btn btn-dark" href="#posts">Read latest posts</a>
        <a class="btn btn-ghost" href={SITE.github}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
          GitHub
        </a>
      </div>
    </div>
  </section>

  <section id="posts" class="wrap block">
    <div class="section-head">
      <h2><Leaf /> 全部文章</h2>
      <span class="count">{posts.length} 篇</span>
    </div>
    {posts.map((post) => <PostRow post={post} />)}
  </section>


  <section id="subscribe" class="wrap block last">
    <div class="sub">
      <svg width="180" height="180" viewBox="0 0 32 32" aria-hidden="true" class="sub-leaf"><path d="M6 26C6 15 13 6 26 6C26 19 17 26 6 26Z" style="fill:var(--green-mid)"></path></svg>
      <div style="position:relative;flex:1 1 360px;min-width:0">
        <h2 style="margin:0 0 10px;font-size:26px">新文章发布时通知我</h2>
        <p style="margin:0;font-size:16px;line-height:1.7;color:var(--soft-text)">用任意 RSS 阅读器订阅，不发广告，随时退订。</p>
      </div>
      <a class="btn btn-green" href="/rss.xml" style="position:relative">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
        RSS 订阅
      </a>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; }
  .hero-leaf { position: absolute; right: -40px; top: 40px; pointer-events: none; }
  .hero-inner { position: relative; padding-top: 96px; padding-bottom: 72px; }
  .pill { margin: 0 0 20px; display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 999px; background: var(--green-soft); font-family: var(--mono); font-size: 14px; color: var(--green-deep); }
  .pill span { width: 6px; height: 6px; border-radius: 50%; background: var(--green); }
  h1 { margin: 0; font-size: clamp(36px, 6vw, 64px); line-height: 1.12; font-weight: 900; letter-spacing: -0.02em; max-width: 820px; }
  h1 em { font-style: normal; color: var(--green); }
  .bio { margin: 28px 0 0; font-size: 18px; line-height: 1.8; color: var(--muted); max-width: 640px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .block { padding-bottom: 72px; }
  .block.last { padding-bottom: 96px; }
  .count { font-family: var(--mono); font-size: 14px; color: var(--muted); }
  .sub { position: relative; overflow: hidden; background: var(--green-soft); border-radius: 20px; padding: 48px 40px; display: flex; flex-wrap: wrap; gap: 32px; align-items: center; justify-content: space-between; }
  .sub-leaf { position: absolute; left: -40px; bottom: -60px; opacity: .5; pointer-events: none; }
  @media (max-width: 640px) { .hero-leaf { opacity: .5; } .sub { padding: 32px 24px; } }
</style>
