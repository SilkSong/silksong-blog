---
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import { getPosts, SITE } from '../site';
const posts = await getPosts();
---
<Base current="posts">
  <section id="about" lang="en" class="hero">
    <div class="wrap hero-inner">
      <h1>Hi, I'm SilkSong.<br />A programmer who thinks, <em>writes</em> &amp; shares.</h1>
      <p class="bio">This blog is my space to think out loud, keep notes, and share what I learn along the way. I love open source and AI, and right now I'm digging deep into how to build AI agents.</p>
      <div class="cta">
        <a class="btn btn-dark" href="#posts">Read latest posts</a>
        <a class="btn btn-ghost" href={SITE.github}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
          GitHub
        </a>
      </div>
    </div>
  </section>

  <section id="posts" class="wrap block last">
    <div class="section-head">
      <h2>全部文章</h2>
      <span class="count">{posts.length} 篇</span>
    </div>
    {posts.map((post) => <PostRow post={post} />)}
  </section>

</Base>

<style>
  .hero { position: relative; overflow: hidden; }
  .hero-inner { position: relative; padding-top: 96px; padding-bottom: 72px; }
  h1 { margin: 0; font-size: clamp(36px, 6vw, 64px); line-height: 1.12; font-weight: 900; letter-spacing: -0.02em; max-width: 820px; }
  h1 em { font-style: normal; color: var(--green); }
  .bio { margin: 28px 0 0; font-size: 18px; line-height: 1.8; color: var(--muted); max-width: 640px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .block { padding-bottom: 72px; }
  .block.last { padding-bottom: 96px; }
  .count { font-family: var(--mono); font-size: 14px; color: var(--muted); }
</style>
