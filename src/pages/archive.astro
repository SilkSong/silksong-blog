---
import Base from '../layouts/Base.astro';
import { getPosts, postUrl, formatDate } from '../site';
const posts = await getPosts();
const years = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  if (!years.has(y)) years.set(y, []);
  years.get(y)!.push(p);
}
---
<Base title="归档" current="archive">
  <section class="wrap" style="padding-top:72px;padding-bottom:96px">
    <div class="section-head">
      <h2>归档</h2>
      <span style="font-family:var(--mono);font-size:14px;color:var(--muted)">共 {posts.length} 篇</span>
    </div>
    {[...years].map(([year, list]) => (
      <div class="year">
        <h3><span>{year}</span><small>{list.length} 篇</small></h3>
        <ol class="timeline">
          {list.map((p) => (
            <li>
              <a href={postUrl(p)} class="item">
                <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date).slice(5)}</time>
                <span class="ul">{p.data.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>
</Base>

<style>
  .year { margin-top: 48px; }
  .year h3 { margin: 0 0 12px; display: flex; align-items: baseline; gap: 12px; font-family: var(--mono); font-size: 32px; font-weight: 500; color: var(--ink); }
  .year h3 small { font-size: 14px; color: var(--muted); }
  .timeline { list-style: none; margin: 0; padding: 0 0 0 20px; border-left: 2px solid var(--green-mid); }
  .timeline li { position: relative; }
  .timeline li::before { content: ""; position: absolute; left: -26px; top: 50%; width: 10px; height: 10px; margin-top: -5px; border-radius: 50%; background: var(--bg); border: 2px solid var(--green-mid); transition: background-color .25s, border-color .25s, transform .25s; }
  .timeline li:hover::before { background: var(--green); border-color: var(--green); transform: scale(1.3); }
  .item { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 24px; padding: 14px 0; text-decoration: none; font-size: 17px; line-height: 1.5; transition: transform .3s ease; }
  .item:hover { transform: translateX(6px); }
  .item time { flex: 0 0 56px; font-family: var(--mono); font-size: 14px; color: var(--muted); transition: color .3s; }
  .item:hover time { color: var(--green); }
  .item:hover .ul { background-size: 100% 40%; color: var(--hl-text); }
</style>
