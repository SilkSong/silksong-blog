---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Leaf from '../../components/Leaf.astro';
import { getPosts, formatDate, readingTime, tagUrl, postUrl, SITE } from '../../site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description ?? undefined}>
  <article class="article">
    <a href="/" class="back">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"></path><path d="M12 19l-7-7 7-7"></path></svg>
      返回首页
    </a>
    <div class="post-meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)} 分钟阅读</span>
      {post.data.tags.map((t) => <a class="tag" href={tagUrl(t)}>{t}</a>)}
    </div>
    <h1><span class="mark">{post.data.title}</span></h1>
    <div class="divider"></div>
    <div class="prose"><Content /></div>

    <div class="author">
      <div class="avatar"><svg width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><path d="M8.5 23.5C8.5 14.5 14.5 8.5 24 8.5C24 18 18 23.5 8.5 23.5Z" style="fill:var(--green)"></path><path d="M8.5 23.5L18 14" style="stroke:var(--surface)" stroke-width="1.6" stroke-linecap="round"></path></svg></div>
      <div lang="en" style="flex:1 1 280px;min-width:0">
        <p style="margin:0;font-size:17px;font-weight:700">{SITE.name}</p>
        <p style="margin:6px 0 0;font-size:15px;line-height:1.7;color:var(--soft-text)">Programmer. Open source &amp; AI enthusiast, currently learning to build AI agents.</p>
      </div>
      <a class="btn btn-green" href="/rss.xml" style="min-height:44px">订阅更新</a>
    </div>

    <nav class="pager" aria-label="上一篇和下一篇">
      {newer ? <a class="card" href={postUrl(newer)}><span class="lbl">← 较新一篇</span><span class="t">{newer.data.title}</span></a> : <span></span>}
      {older && <a class="card right" href={postUrl(older)}><span class="lbl">较早一篇 →</span><span class="t">{older.data.title}</span></a>}
    </nav>
  </article>
</Base>

<style>
  .article { max-width: 720px; margin: 0 auto; padding: 56px 24px 64px; }
  .back { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-size: 15px; color: var(--muted); text-decoration: none; }
  .back svg { transition: transform .3s ease; }
  .back:hover svg { transform: translateX(-4px); }
  .post-meta { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; margin-top: 32px; font-family: var(--mono); font-size: 14px; color: var(--muted); }
  .post-meta .tag { font-family: var(--sans); }
  h1 { margin: 20px 0 0; font-size: clamp(28px, 5vw, 42px); line-height: 1.35; font-weight: 900; letter-spacing: -0.01em; }
  .mark { background-image: linear-gradient(var(--green-mid), var(--green-mid)); background-repeat: no-repeat; background-position: 0 88%; background-size: 0% 35%; transition: background-size .6s ease; }
  h1:hover .mark { background-size: 100% 35%; }
  .divider { height: 1px; background: var(--line); margin: 36px 0; }
  .author { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; margin-top: 56px; padding: 28px; border-radius: 20px; background: var(--green-soft); }
  .avatar { width: 64px; height: 64px; border-radius: 50%; background: var(--surface); display: flex; align-items: center; justify-content: center; flex: 0 0 64px; }
  .pager { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-top: 40px; }
  .card { display: flex; flex-direction: column; gap: 6px; padding: 20px 24px; border-radius: 16px; border: 1px solid var(--line); text-decoration: none; transition: border-color .25s, background-color .25s, transform .25s; }
  .card:hover { border-color: var(--green); background: var(--card-hover); transform: translateY(-3px); }
  .card.right { text-align: right; }
  .lbl { font-size: 13px; color: var(--muted); }
  .t { font-size: 16px; font-weight: 500; line-height: 1.5; }

  .prose { font-size: 17px; line-height: 1.95; color: var(--text); overflow-wrap: break-word; }
  .prose :global(p) { margin: 0 0 1.4em; }
  .prose :global(h2), .prose :global(h3), .prose :global(h4) { color: var(--ink); line-height: 1.4; margin: 2em 0 .8em; }
  .prose :global(h2) { font-size: 26px; display: flex; align-items: center; gap: 10px; }
  .prose :global(h2)::before { content: ""; flex: none; width: 16px; height: 16px; background: var(--green); clip-path: path('M3 13C3 7.5 6.5 3 13 3C13 9.5 8.5 13 3 13Z'); }
  .prose :global(h3) { font-size: 21px; }
  .prose :global(h4) { font-size: 18px; }
  .prose :global(a) { color: var(--green); text-underline-offset: 3px; }
  .prose :global(a:hover) { color: var(--green-deep); }
  .prose :global(img) { max-width: 100%; height: auto; border-radius: 12px; display: block; margin: 1.6em auto; }
  .prose :global(:not(pre) > code) { font-family: var(--mono); font-size: .88em; padding: 2px 6px; border-radius: 6px; background: var(--code-bg); }
  .prose :global(pre) { margin: 0 0 1.6em; padding: 20px 24px; border-radius: 14px; background: var(--pre-bg) !important; border: 1px solid var(--line); font-family: var(--mono); font-size: 14px; line-height: 1.7; overflow-x: auto; }
  .prose :global(pre code) { font-family: var(--mono); }
  .prose :global(blockquote) { margin: 1.6em 0; padding: 4px 0 4px 36px; position: relative; color: var(--ink); }
  .prose :global(blockquote)::before { content: "“"; position: absolute; left: 0; top: -14px; font-size: 48px; line-height: 1; color: var(--green); }
  .prose :global(blockquote p) { margin: 0 0 .6em; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.4em; margin: 0 0 1.4em; }
  .prose :global(li::marker) { color: var(--green); }
  .prose :global(table) { display: block; overflow-x: auto; border-collapse: collapse; margin: 0 0 1.6em; font-size: 15px; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--line); padding: 8px 12px; }
  .prose :global(hr) { border: 0; height: 1px; background: var(--line); margin: 2.4em 0; }
</style>
