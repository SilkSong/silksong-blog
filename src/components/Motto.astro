---
interface Props { size?: string }
const { size = '28px' } = Astro.props;
---
<div class="motto-block">
  <p class="motto" style={`font-size:${size}`}>
    整个江湖都任我闯，我的生命像一首<span class="ge">歌<svg class="note" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg></span>
  </p>
  <p class="motto-en" lang="en">The whole wide world is mine to roam; my life is like a song.</p>
</div>
